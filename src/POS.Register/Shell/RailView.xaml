<UserControl x:Class="POS.Register.Shell.RailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <UserControl.Resources>
        <lib:StringEqualsToBoolConverter x:Key="ActiveNav" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="RailItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Rail" />
            <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Width="64" Height="60" CornerRadius="12"
                                Background="Transparent" Margin="0,4">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="20" HorizontalAlignment="Center" />
                                <ContentPresenter HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{StaticResource GreenSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource GreenDeep}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Ink2}" />
            <Setter Property="Width" Value="64" />
            <Setter Property="Height" Value="60" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource Paper2}" BorderBrush="{StaticResource LineStrong}" BorderThickness="0,0,1,0">
        <DockPanel LastChildFill="False" Margin="0,14">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="&#x25C8;" FontSize="26" Foreground="{StaticResource Green}"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                <RadioButton Style="{StaticResource RailItem}" Tag="&#x1F6D2;" Content="SELL"
                             IsChecked="{Binding ActiveScreenName, Mode=OneWay, Converter={StaticResource ActiveNav}, ConverterParameter=Sell}"
                             Command="{Binding NavigateCommand}" CommandParameter="Sell" HorizontalAlignment="Center" />
                <RadioButton Style="{StaticResource RailItem}" Tag="&#x1F4D2;" Content="INVOICE"
                             IsChecked="{Binding ActiveScreenName, Mode=OneWay, Converter={StaticResource ActiveNav}, ConverterParameter=Invoices}"
                             Command="{Binding NavigateCommand}" CommandParameter="Invoices" HorizontalAlignment="Center"
                             Visibility="{Binding ShowInvoiceRail, Converter={StaticResource BoolToVis}}" />
                <RadioButton Style="{StaticResource RailItem}" Tag="&#x1F4B5;" Content="SHIFT"
                             IsChecked="{Binding ActiveScreenName, Mode=OneWay, Converter={StaticResource ActiveNav}, ConverterParameter=Shift}"
                             Command="{Binding NavigateCommand}" CommandParameter="Shift" HorizontalAlignment="Center" />
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}"
                    Command="{Binding LockCommand}" HorizontalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="&#x1F512;" FontSize="20" HorizontalAlignment="Center" />
                    <TextBlock Text="LOCK" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Ink2}"
                               HorizontalAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Button>
        </DockPanel>
    </Border>
</UserControl>
