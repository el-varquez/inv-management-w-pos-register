<UserControl x:Class="POS.Register.Shell.TopbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,0">
        <DockPanel Height="64">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold"
                       Text="{Binding Settings.StoreName}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Border DockPanel.Dock="Left" VerticalAlignment="Center" CornerRadius="14" Padding="12,5" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource RedSoft}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Red}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Day.IsShiftOpen}" Value="True">
                                <Setter Property="Background" Value="{StaticResource ConfirmSoft}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Confirm}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="12" FontWeight="Bold" FontFamily="{StaticResource FontUI}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{x:Static lib:CannedDay.FreshChip}" />
                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Day.IsShiftOpen}" Value="True">
                                    <Setter Property="Text" Value="{x:Static lib:CannedDay.OpenChip}" />
                                    <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Day.IsClosed}" Value="True">
                                    <Setter Property="Text" Value="{x:Static lib:CannedDay.ClosedChip}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontWeight="Bold"
                       Text="{Binding Clock}" VerticalAlignment="Center" MinWidth="92"
                       TextAlignment="Right" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontSize="13"
                       Foreground="{StaticResource Ink3}" Text="{Binding DateShort}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                       Foreground="{StaticResource Ink2}" Text="{Binding Session.Name}"
                       VerticalAlignment="Center" Margin="0,0,14,0" />
            <Grid />
        </DockPanel>
    </Border>
</UserControl>
