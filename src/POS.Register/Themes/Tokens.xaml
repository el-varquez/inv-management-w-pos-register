<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorPaper">#FFFFFF</Color>
    <Color x:Key="ColorPaper2">#E6EDE8</Color>
    <Color x:Key="ColorCanvas">#F2F6F3</Color>
    <Color x:Key="ColorSurface">#FFFFFF</Color>
    <Color x:Key="ColorSurface2">#F4F8F5</Color>
    <Color x:Key="ColorInk">#17241D</Color>
    <Color x:Key="ColorInk2">#4C5C53</Color>
    <Color x:Key="ColorInk3">#75867C</Color>
    <Color x:Key="ColorLine">#E0E8E2</Color>
    <Color x:Key="ColorLineStrong">#C5D3CA</Color>
    <Color x:Key="ColorGreen">#1E7A4C</Color>
    <Color x:Key="ColorGreenDeep">#16603A</Color>
    <Color x:Key="ColorGreenSoft">#1A1E7A4C</Color>
    <Color x:Key="ColorConfirm">#2E6B4E</Color>
    <Color x:Key="ColorConfirmSoft">#1F2E6B4E</Color>
    <Color x:Key="ColorRed">#B23A2E</Color>
    <Color x:Key="ColorRedSoft">#1FB23A2E</Color>
    <Color x:Key="ColorGold">#B0823A</Color>
    <Color x:Key="ColorGoldSoft">#24B0823A</Color>
    <Color x:Key="ColorScrim">#6617241D</Color>
    <Color x:Key="ColorCanvasVeil">#D1F2F6F3</Color>
    <Color x:Key="ColorShadow">#172E23</Color>

    <SolidColorBrush x:Key="Paper" Color="{StaticResource ColorPaper}" />
    <SolidColorBrush x:Key="Paper2" Color="{StaticResource ColorPaper2}" />
    <SolidColorBrush x:Key="Canvas" Color="{StaticResource ColorCanvas}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource ColorSurface2}" />
    <SolidColorBrush x:Key="Ink" Color="{StaticResource ColorInk}" />
    <SolidColorBrush x:Key="Ink2" Color="{StaticResource ColorInk2}" />
    <SolidColorBrush x:Key="Ink3" Color="{StaticResource ColorInk3}" />
    <SolidColorBrush x:Key="Line" Color="{StaticResource ColorLine}" />
    <SolidColorBrush x:Key="LineStrong" Color="{StaticResource ColorLineStrong}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource ColorGreen}" />
    <SolidColorBrush x:Key="GreenDeep" Color="{StaticResource ColorGreenDeep}" />
    <SolidColorBrush x:Key="GreenSoft" Color="{StaticResource ColorGreenSoft}" />
    <SolidColorBrush x:Key="Confirm" Color="{StaticResource ColorConfirm}" />
    <SolidColorBrush x:Key="ConfirmSoft" Color="{StaticResource ColorConfirmSoft}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource ColorRed}" />
    <SolidColorBrush x:Key="RedSoft" Color="{StaticResource ColorRedSoft}" />
    <SolidColorBrush x:Key="Gold" Color="{StaticResource ColorGold}" />
    <SolidColorBrush x:Key="GoldSoft" Color="{StaticResource ColorGoldSoft}" />
    <SolidColorBrush x:Key="Scrim" Color="{StaticResource ColorScrim}" />
    <SolidColorBrush x:Key="CanvasVeil" Color="{StaticResource ColorCanvasVeil}" />

    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>

    <DropShadowEffect x:Key="ShadowSm" Color="{StaticResource ColorShadow}" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity="0.06" />
    <DropShadowEffect x:Key="ShadowLg" Color="{StaticResource ColorShadow}" BlurRadius="40" ShadowDepth="11" Direction="270" Opacity="0.30" />

</ResourceDictionary>
