<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <FontFamily x:Key="FontDisplay">pack://application:,,,/Assets/Fonts/#Fraunces 72pt 72pt NonWonky</FontFamily>
    <FontFamily x:Key="FontUI">pack://application:,,,/Assets/Fonts/#Hanken Grotesk</FontFamily>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink3}" />
    </Style>

    <Style x:Key="TitleSection" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontDisplay}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="MoneyModal" TargetType="TextBlock" BasedOn="{StaticResource TitleSection}">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="MoneyLarge" TargetType="TextBlock" BasedOn="{StaticResource TitleSection}">
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}" />

</ResourceDictionary>
