<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BtnBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.92" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BtnPrimary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Green}" />
        <Setter Property="BorderBrush" Value="{StaticResource Green}" />
        <Setter Property="Foreground" Value="{StaticResource Paper}" />
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource GreenDeep}" />
                <Setter Property="BorderBrush" Value="{StaticResource GreenDeep}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BtnPayHero" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="BtnDanger" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource RedSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Red}" />
        <Setter Property="Foreground" Value="{StaticResource Red}" />
    </Style>

    <Style x:Key="BtnOutlineGreen" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource GreenSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Green}" />
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BtnUtang" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource GoldSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource Gold}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BtnUtangSolid" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Gold}" />
        <Setter Property="BorderBrush" Value="{StaticResource Gold}" />
        <Setter Property="Foreground" Value="{StaticResource Paper}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BtnDangerSolid" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Red}" />
        <Setter Property="BorderBrush" Value="{StaticResource Red}" />
        <Setter Property="Foreground" Value="{StaticResource Paper}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BtnConfirmSolid" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Confirm}" />
        <Setter Property="BorderBrush" Value="{StaticResource Confirm}" />
        <Setter Property="Foreground" Value="{StaticResource Paper}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BtnKey" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="FontSize" Value="22" />
    </Style>

    <Style x:Key="InputText" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource RadiusControl}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource Green}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="ChipOk" TargetType="Border" BasedOn="{StaticResource ChipBase}">
        <Setter Property="Background" Value="{StaticResource ConfirmSoft}" />
    </Style>
    <Style x:Key="ChipVoid" TargetType="Border" BasedOn="{StaticResource ChipBase}">
        <Setter Property="Background" Value="{StaticResource RedSoft}" />
    </Style>
    <Style x:Key="ChipUtang" TargetType="Border" BasedOn="{StaticResource ChipBase}">
        <Setter Property="Background" Value="{StaticResource GoldSoft}" />
    </Style>

    <Style x:Key="SegBar" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Paper2}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="SegTabBase" TargetType="Button" BasedOn="{StaticResource BtnBase}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink2}" />
    </Style>

    <Style x:Key="SegTabRing" TargetType="Button" BasedOn="{StaticResource SegTabBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowingRing}" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="Foreground" Value="{StaticResource GreenDeep}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SegTabList" TargetType="Button" BasedOn="{StaticResource SegTabBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding ShowingList}" Value="True">
                <Setter Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="Foreground" Value="{StaticResource GreenDeep}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Effect" Value="{StaticResource ShadowSm}" />
    </Style>

    <Style x:Key="ModalCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Effect" Value="{StaticResource ShadowLg}" />
        <Setter Property="Padding" Value="28" />
    </Style>

    <Style x:Key="DashRule" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Stroke" Value="{StaticResource LineStrong}" />
        <Setter Property="StrokeDashArray" Value="2 3" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
