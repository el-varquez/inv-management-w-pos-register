<UserControl x:Class="POS.Register.Features.Shifts.Components.XReadModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Border Style="{StaticResource ModalCard}" Width="540" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold"
                       Text="{Binding Title}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Denominations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Canvas}" BorderThickness="0,0,0,1" Padding="0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Text="{Binding Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnKey}" Content="−" MinHeight="38" Width="38" Padding="0" FontSize="18"
                                            Command="{Binding DataContext.DecrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="16" FontWeight="Bold" Text="{Binding Count}"
                                               MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Style="{StaticResource BtnKey}" Content="+" MinHeight="38" Width="38" Padding="0" FontSize="18"
                                            Command="{Binding DataContext.IncrementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource TitleSection}" FontSize="15"
                                           Text="{Binding Total, StringFormat=₱{0:N2}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,12,0,6">
                <TextBlock Style="{StaticResource Caption}" Text="COUNTED TOTAL" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="32"
                           Text="{Binding CountedDisplay}" HorizontalAlignment="Right" />
            </DockPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource BodyText}" FontSize="14" Foreground="{StaticResource Ink2}"
                           Text="Expected cash in drawer" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TitleSection}" FontSize="15"
                           Text="{Binding ExpectedDisplay}" HorizontalAlignment="Right" />
            </DockPanel>
            <Border CornerRadius="{StaticResource RadiusControl}" Padding="18,14" Margin="0,0,0,14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource ConfirmSoft}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VerdictTone}" Value="Red">
                                <Setter Property="Background" Value="{StaticResource RedSoft}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding VerdictTone}" Value="Gold">
                                <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Verdict}" HorizontalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerdictTone}" Value="Red">
                                    <Setter Property="Foreground" Value="{StaticResource Red}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding VerdictTone}" Value="Gold">
                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <StackPanel Visibility="{Binding ShowWallet, Converter={StaticResource BoolToVis}}">
                <Rectangle Style="{StaticResource DashRule}" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource Caption}" Text="E-WALLET — SECOND DRAWER" Margin="0,0,0,10" />
                <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}" Padding="16,10" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink2}"
                                   Text="Counted balance (from the app)" VerticalAlignment="Center" />
                        <TextBox DockPanel.Dock="Right" BorderThickness="0" Background="Transparent" TextAlignment="Right"
                                 FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="Bold"
                                 Foreground="{StaticResource Ink}" VerticalAlignment="Center" MaxLength="7" MinWidth="90"
                                 Text="{Binding WalletCounted.Digits, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="OnWalletTextInput" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="22"
                                   Text="₱" Margin="0,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="14" Foreground="{StaticResource Ink2}"
                               Text="Expected wallet balance" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource TitleSection}" FontSize="15"
                               Text="{Binding WalletExpectedDisplay}" HorizontalAlignment="Right" />
                </DockPanel>
                <Border CornerRadius="{StaticResource RadiusControl}" Padding="16,11" Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource ConfirmSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WalletVerdictTone}" Value="Red">
                                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding WalletVerdictTone}" Value="Gold">
                                    <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="13" Text="{Binding WalletVerdict}" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WalletVerdictTone}" Value="Red">
                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding WalletVerdictTone}" Value="Gold">
                                        <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="54" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnDangerSolid}" Content="END SHIFT — X READ" MinHeight="54"
                        Command="{Binding EndShiftCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
