<UserControl x:Class="POS.Register.Features.Shifts.Components.ZReadModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ModalCard}" Width="540" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold"
                       Text="Close shift #12 — count the drawer" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Denominations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource Canvas}" BorderThickness="0,0,0,1" Padding="0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Text="{Binding Label}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button Style="{StaticResource BtnKey}" Content="−" MinHeight="38" Width="38" Padding="0" FontSize="18" />
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="16" FontWeight="Bold" Text="{Binding Count}"
                                               MinWidth="34" TextAlignment="Center" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Style="{StaticResource BtnKey}" Content="+" MinHeight="38" Width="38" Padding="0" FontSize="18" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Style="{StaticResource TitleSection}" FontSize="15"
                                           Text="{Binding Total, StringFormat=₱{0:N2}}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,12,0,6">
                <TextBlock Style="{StaticResource Caption}" Text="COUNTED TOTAL" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="32"
                           Text="{Binding CountedDisplay}" HorizontalAlignment="Right" />
            </DockPanel>
            <DockPanel Margin="0,0,0,12">
                <TextBlock Style="{StaticResource BodyText}" FontSize="14" Foreground="{StaticResource Ink2}"
                           Text="Expected cash in drawer" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource TitleSection}" FontSize="15"
                           Text="{Binding ExpectedDisplay}" HorizontalAlignment="Right" />
            </DockPanel>
            <Border Background="{StaticResource RedSoft}" CornerRadius="{StaticResource RadiusControl}"
                    Padding="18,14" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Foreground="{StaticResource Red}"
                           Text="{Binding Verdict}" HorizontalAlignment="Center" />
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="54" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnDangerSolid}" Content="CLOSE SHIFT — Z READ" MinHeight="54"
                        Command="{Binding CloseShiftCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
