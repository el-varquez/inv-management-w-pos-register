<UserControl x:Class="POS.Register.Features.Shifts.Screens.ShiftScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <lib:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface2}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource TitleSection}">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Top">
        <Border Style="{StaticResource Card}" Padding="26" Margin="0,0,0,16"
                Visibility="{Binding ShellVm.Day.IsShiftOpen, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Style="{StaticResource TitleSection}" FontSize="24" FontWeight="Bold" Text="{Binding OpenTitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}" Background="{StaticResource ConfirmSoft}"
                            BorderBrush="{StaticResource Confirm}" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource PillText}" Foreground="{StaticResource Confirm}" Text="OPEN" />
                    </Border>
                </StackPanel>
                <UniformGrid Columns="2" Margin="0,0,-12,4">
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="OPENED" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding OpenedAt}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="STARTING CASH" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding StartingCashDisplay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="NET SALES SO FAR" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding NetSalesDisplay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StatTile}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Text="EXPECTED CASH" />
                            <TextBlock Style="{StaticResource StatValue}" Text="{Binding ExpectedCashDisplay}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Button Style="{StaticResource BtnKey}" FontSize="13" FontWeight="Bold" MinHeight="48"
                        Foreground="{StaticResource Ink2}" Content="PAYOUT / PAY-IN — RECORD CASH LEAVING OR ENTERING"
                        Command="{Binding OpenMovementCommand}" Margin="0,0,0,16" />
                <TextBlock Style="{StaticResource Caption}" Text="DRAWER MOVEMENTS" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Movements}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="12,9" Margin="0,0,0,6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Surface2}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding AmountDisplay}" FontFamily="{StaticResource FontDisplay}" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPayout}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Red}" Text="Void" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsVoided, Converter={StaticResource InverseBoolToVis}}" />
                                    </StackPanel>
                                    <TextBlock FontSize="14" Text="{Binding Note}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource BtnDangerSolid}" Content="END SHIFT (X READ)" MinHeight="52"
                        Command="{Binding EndShiftCommand}" />
            </StackPanel>
        </Border>
        <Border Padding="26" Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Card}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShellVm.Day.IsShiftOpen}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource TitleSection}" FontSize="24" FontWeight="Bold"
                               Text="{Binding ClosedTitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}" Background="{StaticResource RedSoft}"
                            BorderBrush="{StaticResource Red}" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource PillText}" Foreground="{StaticResource Red}" Text="ENDED" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource Ink2}"
                           TextWrapping="Wrap" Text="{Binding ClosedSub}" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                           Text="A mistaken X read can only be corrected by an Admin (logged)." Margin="0,0,0,16" />
                <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Red}"
                           TextWrapping="Wrap" Text="{Binding StoreClosedNote}"
                           Visibility="{Binding IsStoreClosedToday, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource BtnPrimary}" FontSize="14" MinHeight="56"
                        Content="{Binding OpenButtonText}"
                        Command="{Binding OpenStartingCashCommand}"
                        Visibility="{Binding CanOpenShift, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="26">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource TitleSection}" FontSize="24" FontWeight="Bold"
                               Text="{Binding DayTitle}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Pill}" Background="{StaticResource ConfirmSoft}"
                            BorderBrush="{StaticResource Confirm}" Margin="12,0,0,0"
                            Visibility="{Binding IsDayOpen, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PillText}" Foreground="{StaticResource Confirm}" Text="OPEN" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource RedSoft}"
                            BorderBrush="{StaticResource Red}" Margin="12,0,0,0"
                            Visibility="{Binding HasClosedDay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PillText}" Foreground="{StaticResource Red}" Text="CLOSED" />
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource GoldSoft}"
                            BorderBrush="{StaticResource Gold}" Margin="8,0,0,0"
                            Visibility="{Binding DayClosedLate, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PillText}" Foreground="{StaticResource Gold}" Text="LATE" />
                    </Border>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource Ink2}"
                           TextWrapping="Wrap" Text="{Binding DaySub}" Margin="0,0,0,12" />
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                           Text="End the shift first — the Z read closes the whole day." Margin="0,0,0,12"
                           Visibility="{Binding ShowCloseDayHint, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource BtnDangerSolid}" Content="CLOSE DAY (Z READ)" MinHeight="52"
                        Command="{Binding CloseDayCommand}" IsEnabled="{Binding CanCloseDay}"
                        Visibility="{Binding IsDayOpen, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
        </StackPanel>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="32,28" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource TitleSection}" FontSize="20" FontWeight="Bold"
                               Text="{Binding StoreName}" HorizontalAlignment="Center" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" FontWeight="Bold"
                               Text="{Binding ReceiptTitle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="11" FontWeight="Normal"
                               Text="{Binding ReceiptCaption}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                </StackPanel>
                <Rectangle Style="{StaticResource DashRule}" Margin="0,0,0,10" />
                <ItemsControl ItemsSource="{Binding ReceiptRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock Style="{StaticResource Caption}" FontSize="11" FontWeight="Bold"
                                           Text="{Binding Label}" Margin="0,14,0,4"
                                           Visibility="{Binding IsHead, Converter={StaticResource BoolToVis}}" />
                                <Border Padding="0,4" Visibility="{Binding IsHead, Converter={StaticResource InverseBoolToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TopBorder}" Value="True">
                                                    <Setter Property="BorderThickness" Value="0,1.5,0,0" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource FontDisplay}" FontSize="15"
                                                   Text="{Binding Value}" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Red">
                                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Confirm">
                                                            <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Gold">
                                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Bold}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock FontFamily="{StaticResource FontUI}" FontSize="14" Text="{Binding Label}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                    <Setter Property="FontWeight" Value="Normal" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Red">
                                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Confirm">
                                                            <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tone}" Value="Gold">
                                                            <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Bold}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
