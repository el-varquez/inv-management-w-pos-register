<UserControl x:Class="POS.Register.Features.Invoices.Components.ChargeModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:invcomp="clr-namespace:POS.Register.Features.Invoices.Components"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <lib:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Border Style="{StaticResource ModalCard}" Width="560" Padding="26" MaxHeight="1000">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold"
                       Text="Charge to customer" Margin="0,0,0,14" />
            <Border Background="{StaticResource Surface2}" CornerRadius="{StaticResource RadiusControl}"
                    Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink2}" Text="Subtotal" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource Ink2}" Text="{Binding SubtotalDisplay}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink2}" Text="Utang markup" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource Ink2}" Text="{Binding MarkupDisplay}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink2}" Text="Discount" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontSize="12"
                                   Foreground="{StaticResource Ink2}" Text="{Binding DiscountDisplay}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="INVOICE TOTAL" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="34"
                                   Text="{Binding TotalDisplay}" HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Grid Margin="0,0,0,12">
                <TextBox x:Name="SearchBox" Style="{StaticResource InputText}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Foreground="{StaticResource Ink3}"
                           Text="Search suki by name or phone…" Margin="14,0"
                           VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Search}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type invcomp:SukiRow}">
                                <Button Command="{Binding DataContext.PickSukiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,6">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="RowBg" Background="{StaticResource Surface}"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="2"
                                                    CornerRadius="{StaticResource RadiusControl}" Padding="14,10">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19"
                                                            Background="{StaticResource Paper2}" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource MoneyModal}" FontSize="17"
                                                                   Foreground="{StaticResource Ink2}" Text="{Binding Initial}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock x:Name="Balance" DockPanel.Dock="Right" Style="{StaticResource MoneyModal}"
                                                               FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                               Text="{Binding BalanceDisplay}" VerticalAlignment="Center" />
                                                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                   Foreground="{StaticResource Ink3}" Text="{Binding PhoneDisplay}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource Green}" />
                                                    <Setter TargetName="RowBg" Property="Background" Value="{StaticResource GreenSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource Green}" />
                                                    <Setter TargetName="RowBg" Property="Background" Value="{StaticResource GreenSoft}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsZeroBalance}" Value="True">
                                                    <Setter TargetName="Balance" Property="Foreground" Value="{StaticResource Confirm}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Visibility="{Binding AddingSuki, Converter={StaticResource InverseBoolToVis}}">
                        <Rectangle Stroke="{StaticResource LineStrong}" StrokeThickness="2" StrokeDashArray="3 3"
                                   RadiusX="10" RadiusY="10" SnapsToDevicePixels="True" />
                        <Button Style="{StaticResource BtnGhost}" BorderThickness="0" Background="Transparent"
                                Foreground="{StaticResource Green}" FontWeight="Bold" Content="＋ Add new suki"
                                MinHeight="46" Command="{Binding ToggleAddSukiCommand}" />
                    </Grid>
                    <Grid Visibility="{Binding AddingSuki, Converter={StaticResource BoolToVis}}">
                        <Rectangle Stroke="{StaticResource Green}" StrokeThickness="2" StrokeDashArray="3 3"
                                   RadiusX="10" RadiusY="10" SnapsToDevicePixels="True"
                                   Fill="{StaticResource Surface2}" />
                        <StackPanel Margin="12">
                            <Grid Margin="0,0,0,8">
                                <TextBox x:Name="NewNameBox" Style="{StaticResource InputText}" MinHeight="40"
                                         Background="{StaticResource Surface}"
                                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Foreground="{StaticResource Ink3}" Text="Full name" Margin="12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBox Style="{StaticResource InputText}" MinHeight="40"
                                         Background="{StaticResource Surface}"
                                         Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Foreground="{StaticResource Ink3}" Text="Phone (09xx…)" Margin="12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewPhone}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnConfirmSolid}" Content="Save &amp; select" MinHeight="40"
                                        Command="{Binding SaveSukiCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="40"
                                        Padding="14,0" Command="{Binding ToggleAddSukiCommand}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
            <Border Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="14,10" Margin="0,0,0,10"
                    Visibility="{Binding ShowOverdue, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BodyText}" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource Gold}" Text="{Binding OverdueLine}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                       Text="Charges the full total to the customer's ledger — no cash changes hands."
                       TextWrapping="Wrap" Margin="0,0,0,4" />
            <Grid Margin="0,10,0,0" Visibility="{Binding AwaitingOverdueConfirm, Converter={StaticResource InverseBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="52" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnConfirmSolid}" MinHeight="52" FontSize="13"
                        Content="{Binding CommitLabel}" Command="{Binding ChargeCommand}" />
            </Grid>
            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding AwaitingOverdueConfirm, Converter={StaticResource BoolToVis}}">
                <Border Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}" Padding="16,12" Margin="0,0,0,10">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource Gold}" Text="{Binding OverdueQuestion}"
                               TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource BtnGhost}" Content="CANCEL" MinHeight="52" Padding="20,0"
                            Command="{Binding CancelOverdueCommand}" />
                    <Button Grid.Column="2" Style="{StaticResource BtnConfirmSolid}" Content="CHARGE ANYWAY" MinHeight="52"
                            Command="{Binding ConfirmOverdueCommand}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
