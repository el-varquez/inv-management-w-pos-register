<UserControl x:Class="POS.Register.Features.Invoices.Components.InvoiceDetailModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ModalCard}" Width="520" Padding="26">
        <StackPanel>
            <DockPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold" Text="{Binding Row.Number}" VerticalAlignment="Center" />
                <Border CornerRadius="11" Padding="12,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource GoldSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Row.Voided}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="12" FontWeight="Bold" FontFamily="{StaticResource FontUI}" Text="{Binding Row.Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Row.Voided}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontSize="13"
                           Foreground="{StaticResource Ink3}" Text="{Binding TimeAndSuki}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Margin="0,0,0,14">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Canvas}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource TitleSection}" FontSize="15"
                                                   Text="{Binding Total, StringFormat=₱{0:N2}}" HorizontalAlignment="Right" />
                                        <TextBlock Style="{StaticResource BodyText}">
                                            <Run Text="{Binding Qty, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Ink2}" /><Run Text="×" FontWeight="Bold" Foreground="{StaticResource Ink2}" /><Run Text=" " /><Run Text="{Binding Name, Mode=OneWay}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{StaticResource Surface2}" Padding="16,12" CornerRadius="0,0,10,10">
                        <DockPanel>
                            <TextBlock Style="{StaticResource Caption}" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" Text="CHARGED TO LEDGER" VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="22"
                                       Text="{Binding TotalDisplay}" HorizontalAlignment="Right" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
            <StackPanel Margin="0,0,0,6">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Row.Voided}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Button Style="{StaticResource BtnDangerSolid}" Content="VOID" MinHeight="54"
                        Command="{Binding VoidCommand}" />
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                           Text="Restores stock · clears the charge from the ledger · admin override"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
            <Button Style="{StaticResource BtnGhost}" Content="Close" MinHeight="44" FontWeight="SemiBold"
                    Foreground="{StaticResource Ink2}" Command="{Binding CloseCommand}" />
        </StackPanel>
    </Border>
</UserControl>
