<UserControl x:Class="POS.Register.Features.Sell.Components.EWalletModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <lib:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Border Style="{StaticResource ModalCard}" Width="520" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold" Text="E-wallet" Margin="0,0,0,14" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Button Style="{StaticResource BtnPrimary}" Content="CASH IN" MinHeight="52"
                            Command="{Binding SetCashInCommand}"
                            Visibility="{Binding IsCashIn, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource BtnGhost}" Content="CASH IN" MinHeight="52"
                            Foreground="{StaticResource Ink2}" Command="{Binding SetCashInCommand}"
                            Visibility="{Binding IsCashIn, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
                <Grid Grid.Column="2">
                    <Button Style="{StaticResource BtnPrimary}" Content="CASH OUT" MinHeight="52"
                            Command="{Binding SetCashOutCommand}"
                            Visibility="{Binding IsCashIn, Converter={StaticResource InverseBoolToVis}}" />
                    <Button Style="{StaticResource BtnGhost}" Content="CASH OUT" MinHeight="52"
                            Foreground="{StaticResource Ink2}" Command="{Binding SetCashOutCommand}"
                            Visibility="{Binding IsCashIn, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding AmountLabel}" Margin="0,0,0,7" />
            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="18,10" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Style="{StaticResource MoneyModal}" FontSize="28" Text="₱" VerticalAlignment="Center" />
                    <TextBox x:Name="AmountBox" BorderThickness="0" Background="Transparent" TextAlignment="Right"
                             FontFamily="{StaticResource FontDisplay}" FontSize="28" FontWeight="Bold"
                             Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                             Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="OnMoneyTextInput" GotKeyboardFocus="OnMoneyFocus" />
                </DockPanel>
            </Border>
            <DockPanel Margin="0,0,0,7">
                <TextBlock Style="{StaticResource Caption}" Text="FEE" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="{Binding RateHint}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RateHintTone}" Value="Gold">
                                    <Setter Property="Foreground" Value="{StaticResource Gold}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="18,10" Margin="0,0,0,7">
                <DockPanel>
                    <TextBlock Style="{StaticResource MoneyModal}" FontSize="24" Text="₱" VerticalAlignment="Center" />
                    <TextBox x:Name="FeeBox" BorderThickness="0" Background="Transparent" TextAlignment="Right"
                             FontFamily="{StaticResource FontDisplay}" FontSize="24" FontWeight="Bold"
                             Foreground="{StaticResource Ink}" VerticalAlignment="Center"
                             Text="{Binding FeeText, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="OnMoneyTextInput" GotKeyboardFocus="OnMoneyFocus" />
                </DockPanel>
            </Border>
            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                       TextWrapping="Wrap" Text="{Binding FeeLineCaption}" Margin="0,0,0,14" />
            <Border Background="{StaticResource Surface2}" CornerRadius="{StaticResource RadiusControl}"
                    Padding="18,14" Margin="0,0,0,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Caption}" FontSize="13" FontWeight="Bold"
                                   Foreground="{StaticResource Ink2}" Text="{Binding SettlementLabel}"
                                   VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="30"
                                   Text="{Binding SettlementDisplay}" HorizontalAlignment="Right" />
                    </DockPanel>
                    <DockPanel>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="13"
                                   Foreground="{StaticResource Ink3}" Text="Wallet after" />
                        <TextBlock DockPanel.Dock="Right" FontFamily="{StaticResource FontDisplay}" FontSize="13"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink3}"
                                   Text="{Binding WalletAfterDisplay}" HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="54" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="CONFIRM" MinHeight="54"
                        Command="{Binding ConfirmCommand}" IsEnabled="{Binding CanConfirm}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
