<UserControl x:Class="POS.Register.Features.Utang.Screens.UtangScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib"
             xmlns:local="clr-namespace:POS.Register.Features.Utang.Screens">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <lib:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource Gold}" BorderThickness="1"
                CornerRadius="{StaticResource RadiusControl}" Padding="18,12" Margin="0,0,0,12"
                Visibility="{Binding OffBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{StaticResource Gold}"
                       Text="Utang is OFF — collection-only. No new charges." />
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource BtnUtang}" BorderThickness="1"
                                    Content="＋ Add" MinHeight="42" Padding="14,0" Margin="8,0,0,0"
                                    Command="{Binding ToggleAddSukiCommand}"
                                    Visibility="{Binding CanAddSuki, Converter={StaticResource BoolToVis}}" />
                            <Grid>
                                <TextBox Style="{StaticResource InputText}" MinHeight="42"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Foreground="{StaticResource Ink3}" Text="Search customers…" Margin="12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Search}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Background="{StaticResource Surface2}"
                                Visibility="{Binding AddingSuki, Converter={StaticResource BoolToVis}}">
                        <StackPanel Margin="14,12">
                            <Grid Margin="0,0,0,8">
                                <TextBox Style="{StaticResource InputText}" MinHeight="40"
                                         Background="{StaticResource Surface}"
                                         Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Foreground="{StaticResource Ink3}" Text="Full name" Margin="12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBox Style="{StaticResource InputText}" MinHeight="40"
                                         Background="{StaticResource Surface}"
                                         Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Foreground="{StaticResource Ink3}" Text="Phone (09xx…)" Margin="12,0"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NewPhone}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnConfirmSolid}" Content="Save suki" MinHeight="40"
                                        Command="{Binding SaveSukiCommand}" />
                                <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="40"
                                        Padding="14,0" Command="{Binding ToggleAddSukiCommand}" />
                            </Grid>
                        </StackPanel>
                        <Rectangle Style="{StaticResource DashRule}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SukiRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SukiListRow}">
                                    <Button Command="{Binding DataContext.SelectSukiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RowBg" Background="Transparent"
                                                        BorderBrush="{StaticResource Canvas}" BorderThickness="0,0,0,1"
                                                        Padding="16,13">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20"
                                                                Background="{StaticResource GoldSoft}" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource MoneyModal}" FontSize="17"
                                                                       Foreground="{StaticResource Gold}" Text="{Binding Initial}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock x:Name="Balance" DockPanel.Dock="Right" Style="{StaticResource MoneyModal}"
                                                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                                   Text="{Binding BalanceDisplay}" VerticalAlignment="Center" />
                                                        <StackPanel Margin="12,0" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Text="{Binding Name}" />
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                       Foreground="{StaticResource Ink3}" Text="{Binding PhoneDisplay}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource GoldSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsZeroBalance}" Value="True">
                                                        <Setter TargetName="Balance" Property="Foreground" Value="{StaticResource Confirm}" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Surface2}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Visibility="{Binding HasCust, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,20">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource BtnConfirmSolid}" Content="COLLECT PAYMENT" MinHeight="48"
                                        Padding="20,0" Command="{Binding OpenCollectCommand}" IsEnabled="{Binding CanCollect}" />
                                <Button Style="{StaticResource BtnGhost}" Content="Print statement" MinHeight="40"
                                        Foreground="{StaticResource Ink2}" Margin="0,8,0,0"
                                        Command="{Binding PrintStatementCommand}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Caption}" Text="BALANCE" HorizontalAlignment="Right" />
                                <TextBlock FontSize="40" HorizontalAlignment="Right"
                                           Text="{Binding BalanceDisplay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource MoneyLarge}">
                                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsZeroBalance}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TitleSection}" FontSize="26" FontWeight="Bold"
                                           Text="{Binding CustName}" />
                                <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink3}"
                                           Text="{Binding CustPhone}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource BodyText}" FontSize="12"
                               Foreground="{StaticResource Ink3}" MinHeight="16" Margin="24,6"
                               Text="{Binding CollectCaption}" />
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Caption}" Text="DATE" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Text="ENTRY" Margin="10,0,0,0" />
                            <TextBlock Grid.Column="2" Style="{StaticResource Caption}" Text="CHARGE" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Style="{StaticResource Caption}" Text="PAYMENT" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="4" Style="{StaticResource Caption}" Text="BALANCE" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LedgerRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:LedgerRow}">
                                    <Border BorderBrush="{StaticResource Canvas}" BorderThickness="0,0,0,1" Padding="24,11">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Opacity" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                        <Setter Property="Opacity" Value="0.6" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.Resources>
                                                <Style x:Key="StrikeWhenVoided" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style x:Key="MoneyStrikeWhenVoided" TargetType="TextBlock" BasedOn="{StaticResource MoneyModal}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVoided}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Resources>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource StrikeWhenVoided}" Foreground="{StaticResource Ink2}"
                                                       Text="{Binding Date}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource StrikeWhenVoided}" FontWeight="SemiBold"
                                                               Text="{Binding Entry}" />
                                                    <Border Style="{StaticResource ChipVoid}" Padding="8,2" Margin="8,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsVoided, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Style="{StaticResource BodyText}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource Red}" Text="VOIDED" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                           Foreground="{StaticResource Ink3}" Text="{Binding Sub}"
                                                           Visibility="{Binding HasSub, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Style="{StaticResource MoneyStrikeWhenVoided}" FontSize="15"
                                                       FontWeight="SemiBold" Text="{Binding ChargeDisplay}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource MoneyStrikeWhenVoided}" FontSize="15"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Confirm}"
                                                       Text="{Binding PayDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource MoneyModal}" FontSize="15"
                                                       Text="{Binding BalanceDisplay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Width="32" Height="32" MinHeight="32" Padding="0" FontSize="14"
                                                        Style="{StaticResource BtnGhost}" Background="{StaticResource Surface2}"
                                                        Foreground="{StaticResource Ink2}" Content="✎"
                                                        Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVis}}" />
                                                <Button Width="32" Height="32" MinHeight="32" Padding="0" FontSize="14" Margin="6,0,0,0"
                                                        Style="{StaticResource BtnDanger}" BorderThickness="0" Content="✕"
                                                        Command="{Binding DataContext.VoidEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanVoid, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
