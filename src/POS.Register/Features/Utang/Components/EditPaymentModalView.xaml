<UserControl x:Class="POS.Register.Features.Utang.Components.EditPaymentModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:POS.Register.Components">
    <Border Style="{StaticResource ModalCard}" Width="400" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold"
                       Text="Edit payment" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink2}"
                       Text="{Binding Caption}" TextWrapping="Wrap" Margin="0,0,0,14" />
            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="18,12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="NEW AMOUNT" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource MoneyModal}" FontSize="28" Text="₱" Margin="0,0,4,0"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="AmountBox" BorderThickness="0" Background="Transparent" TextAlignment="Right"
                                 FontFamily="{StaticResource FontDisplay}" FontSize="28" FontWeight="Bold"
                                 Foreground="{StaticResource Ink}" VerticalAlignment="Center" MinWidth="120" MaxLength="10"
                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="OnAmountTextInput" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <comp:NumpadView Margin="0,0,0,14" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="50" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnConfirmSolid}" Content="SAVE" MinHeight="50"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
