<UserControl x:Class="POS.Register.Features.Utang.Components.CollectModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:POS.Register.Components">
    <Border Style="{StaticResource ModalCard}" Width="420" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold"
                       Text="{Binding Title}" Margin="0,0,0,14" />
            <Border Background="{StaticResource Surface2}" CornerRadius="{StaticResource RadiusControl}"
                    Padding="18,12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="BALANCE" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="28"
                               Text="{Binding BalanceDisplay}" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="18,12" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="AMOUNT" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock FontSize="28" Text="₱" Margin="0,0,4,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MoneyModal}">
                                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverBalance}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="AmountBox" BorderThickness="0" Background="Transparent" TextAlignment="Right"
                                 FontFamily="{StaticResource FontDisplay}" FontSize="28" FontWeight="Bold"
                                 VerticalAlignment="Center" MinWidth="120" MaxLength="10"
                                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewTextInput="OnAmountTextInput">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOverBalance}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Red}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Button Style="{StaticResource BtnGhost}" Background="{StaticResource Surface2}" Content="FULL BALANCE"
                    MinHeight="40" FontWeight="Bold" Margin="0,0,0,10" Command="{Binding FullBalanceCommand}" />
            <comp:NumpadView Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                       Text="Cash goes into the drawer and counts as a collection." Margin="0,0,0,14" />
            <TextBlock Style="{StaticResource Caption}" Text="NOTE (OPTIONAL)" Margin="0,0,0,7" />
            <TextBox Style="{StaticResource InputText}" MinHeight="48" MaxLength="200"
                     Text="{Binding NoteText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="52" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnConfirmSolid}" Content="COLLECT" MinHeight="52"
                        Command="{Binding CollectCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
