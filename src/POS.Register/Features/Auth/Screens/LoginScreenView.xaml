<UserControl x:Class="POS.Register.Features.Auth.Screens.LoginScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <UserControl.Resources>
        <lib:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="StagePanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>
    </UserControl.Resources>
    <Grid>
    <Button Style="{StaticResource BtnGhost}" Content="&#x2715;" Width="44" MinHeight="44" Padding="0"
            FontSize="16" Foreground="{StaticResource Ink3}"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,20,0"
            Click="OnCloseClick" />
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
        <TextBlock Style="{StaticResource TitleSection}" FontSize="36" FontWeight="Bold"
                   Text="{Binding Settings.StoreName}" HorizontalAlignment="Center" />
        <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,8,0,26">
            <Run Text="POS REGISTER &#183; " /><Run Text="{Binding DateLong, Mode=OneWay}" />
        </TextBlock>
        <Border Style="{StaticResource ModalCard}" Padding="34">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource StagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="Credentials">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource TitleSection}" FontSize="24" Text="Log in"
                               HorizontalAlignment="Center" Margin="0,0,0,20" />
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource Red}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Style="{StaticResource Caption}" Text="USERNAME" Margin="0,0,0,7" />
                    <Grid Margin="0,0,0,16">
                        <TextBox x:Name="UsernameBox" Style="{StaticResource InputText}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="e.g. nena" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=UsernameBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource Caption}" Text="PASSWORD" Margin="0,0,0,7" />
                    <Grid Margin="0,0,0,22">
                        <PasswordBox x:Name="PasswordBoxField" MinHeight="46" FontSize="16"
                                     VerticalContentAlignment="Center" Padding="12,10"
                                     Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                                     PasswordChanged="OnPasswordChanged" />
                        <TextBlock Text="Your password" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                    <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Password}" Value="" />
                                                <Condition Binding="{Binding IsFocused, ElementName=PasswordBoxField}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Style="{StaticResource BtnPrimary}" Content="LOG IN"
                            Command="{Binding LogInCommand}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource StagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="SetPassword">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource TitleSection}" FontSize="24" Text="Set your password"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Run Text="FIRST LOGIN &#183; " /><Run Text="{Binding Username}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource Red}"
                               FontSize="14" TextWrapping="Wrap" Margin="0,0,0,14"
                               Text="{Binding ErrorMessage}"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Style="{StaticResource Caption}" Text="NEW PASSWORD" Margin="0,0,0,7" />
                    <PasswordBox x:Name="NewPasswordBox" MinHeight="46" FontSize="16" Margin="0,0,0,16"
                                 VerticalContentAlignment="Center" Padding="12,10"
                                 Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                                 PasswordChanged="OnNewPasswordChanged" />
                    <TextBlock Style="{StaticResource Caption}" Text="CONFIRM PASSWORD" Margin="0,0,0,7" />
                    <PasswordBox x:Name="ConfirmPasswordBox" MinHeight="46" FontSize="16" Margin="0,0,0,22"
                                 VerticalContentAlignment="Center" Padding="12,10"
                                 Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                                 PasswordChanged="OnConfirmPasswordChanged" />
                    <Button Style="{StaticResource BtnPrimary}" Content="SET PASSWORD"
                            Command="{Binding SetPasswordCommand}" />
                    <Button Style="{StaticResource BtnGhost}" Content="BACK" Margin="0,10,0,0"
                            Command="{Binding BackToLogInCommand}" />
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel" BasedOn="{StaticResource StagePanel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Stage}" Value="AdminRedirect">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource TitleSection}" FontSize="24" Text="Password not set"
                               HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" Margin="0,0,0,22"
                               Text="Admin passwords are set in the web admin. Open the web admin, log in as admin, and set your password there &#8212; then come back." />
                    <Button Style="{StaticResource BtnGhost}" Content="BACK"
                            Command="{Binding BackToLogInCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
    </Grid>
</UserControl>
