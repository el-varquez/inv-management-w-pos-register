<UserControl x:Class="POS.Register.Components.AdminOverrideModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <UserControl.Resources>
        <lib:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>
    <Border Style="{StaticResource ModalCard}" Width="420" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold" Text="Admin override" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Foreground="{StaticResource Red}"
                       Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink2}"
                       Text="Ask an admin to enter their username and password. The override is logged." TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource Red}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock Style="{StaticResource Caption}" Text="ADMIN USERNAME" Margin="0,0,0,7" />
            <TextBox x:Name="AdminUsernameBox" Style="{StaticResource InputText}"
                     Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
            <TextBlock Style="{StaticResource Caption}" Text="ADMIN PASSWORD" Margin="0,0,0,7" />
            <PasswordBox x:Name="AdminPasswordBox" MinHeight="46" FontSize="16" Margin="0,0,0,14"
                         VerticalContentAlignment="Center" Padding="12,10"
                         Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                         PasswordChanged="OnAdminPasswordChanged" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="50" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnDangerSolid}" Content="CONFIRM OVERRIDE" MinHeight="50"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
