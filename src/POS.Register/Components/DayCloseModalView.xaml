<UserControl x:Class="POS.Register.Components.DayCloseModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:POS.Register.Lib">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <lib:NullToCollapsedConverter x:Key="NullToCollapsed" />
    </UserControl.Resources>
    <Border Style="{StaticResource ModalCard}" Width="440" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold"
                       Text="{Binding Title}" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink2}"
                       TextWrapping="Wrap" Text="{Binding Body}" Margin="0,0,0,14" />
            <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource Red}"
                       FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
            <StackPanel Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink2}"
                           TextWrapping="Wrap" Margin="0,0,0,12"
                           Text="Closing the day needs an admin. Ask one to enter their credentials — the override is logged under their account." />
                <TextBlock Style="{StaticResource Caption}" Text="ADMIN USERNAME" Margin="0,0,0,7" />
                <TextBox Style="{StaticResource InputText}"
                         Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" />
                <TextBlock Style="{StaticResource Caption}" Text="ADMIN PASSWORD" Margin="0,0,0,7" />
                <PasswordBox x:Name="AdminPasswordBox" MinHeight="46" FontSize="16" Margin="0,0,0,14"
                             VerticalContentAlignment="Center" Padding="12,10"
                             Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                             PasswordChanged="OnAdminPasswordChanged" />
            </StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="54" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnDangerSolid}" Content="CLOSE DAY — Z READ" MinHeight="54"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
