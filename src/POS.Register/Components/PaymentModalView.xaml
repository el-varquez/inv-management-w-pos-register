<UserControl x:Class="POS.Register.Components.PaymentModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:POS.Register.Components"
             xmlns:lib="clr-namespace:POS.Register.Lib"
             xmlns:types="clr-namespace:POS.Register.Types">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <lib:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>
    <Border Padding="26" MaxHeight="1000">
        <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource ModalCard}">
                <Setter Property="Width" Value="480" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsInvoice}" Value="True">
                        <Setter Property="Width" Value="560" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold" Text="{Binding Title}" Margin="0,0,0,14" />
            <TextBlock Style="{StaticResource Caption}" Text="PAYMENT METHOD" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,14" Panel.ZIndex="20">
                <Button x:Name="MethodButton" Command="{Binding ToggleMethodCommand}" MinHeight="52" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Green}"
                                    BorderThickness="1.5" CornerRadius="{StaticResource RadiusControl}" Padding="16,0"
                                    MinHeight="52">
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource BodyText}" FontSize="13"
                                               Foreground="{StaticResource Ink3}" Text="▾ F7" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BodyText}" FontSize="16" FontWeight="SemiBold"
                                               Text="{Binding SelectedName}" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Canvas VerticalAlignment="Bottom" Height="0">
                    <Border Canvas.Top="6" Style="{StaticResource Card}" Padding="0"
                            Width="{Binding ActualWidth, ElementName=MethodButton}"
                            Effect="{StaticResource ShadowLg}"
                            Visibility="{Binding IsMethodOpen, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Methods}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type types:PaymentMethodDto}">
                                    <Button Style="{StaticResource BtnGhost}" BorderThickness="0"
                                            HorizontalContentAlignment="Left"
                                            Content="{Binding Name}"
                                            Command="{Binding DataContext.PickMethodCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Canvas>
            </Grid>
            <Border Background="{StaticResource Surface2}" CornerRadius="{StaticResource RadiusControl}" Padding="18,14" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding AmountCaption}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="34"
                               Text="{Binding AmountDueDisplay}" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>
            <StackPanel Visibility="{Binding IsCash, Converter={StaticResource BoolToVis}}">
                <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}" Padding="18,12" Margin="0,0,0,10">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="TENDERED" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Style="{StaticResource MoneyModal}" FontSize="30" Text="₱" Margin="0,0,4,0" />
                            <TextBox x:Name="TenderedBox" Style="{StaticResource InputText}" FontSize="30" MinWidth="150"
                                     BorderThickness="0" Background="Transparent" TextAlignment="Right"
                                     Text="{Binding TenderedText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <ItemsControl ItemsSource="{Binding QuickBills}" Margin="0,0,0,10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource BtnKey}" MinHeight="40" FontSize="14" Padding="14,0"
                                    Content="{Binding Label}" Margin="0,0,6,0"
                                    Command="{Binding DataContext.PickBillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <comp:NumpadView Margin="0,0,0,10" />
                <DockPanel Margin="0,0,0,4">
                    <TextBlock Style="{StaticResource Caption}" Text="CHANGE" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" FontSize="30" Text="{Binding ChangeDisplay}"
                               HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MoneyModal}">
                                <Setter Property="Foreground" Value="{StaticResource Confirm}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInsufficient}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Red}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
            <StackPanel Visibility="{Binding ShowReference, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,8">
                    <TextBox x:Name="ReferenceBox" Style="{StaticResource InputText}" FontSize="17" MinHeight="52"
                             Text="{Binding ReferenceText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{Binding ReferencePlaceholder}" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Foreground" Value="{StaticResource Ink3}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=ReferenceBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                           Text="{Binding EwalletCaption}" TextWrapping="Wrap" Margin="0,0,0,8" />
            </StackPanel>
            <StackPanel Visibility="{Binding IsInvoice, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" Style="{StaticResource InputText}"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Foreground="{StaticResource Ink3}"
                               Text="Search suki by name or phone…" Margin="14,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Search}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type comp:SukiRow}">
                                    <Button Command="{Binding DataContext.PickSukiCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" Margin="0,0,0,6">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="RowBg" Background="{StaticResource Surface}"
                                                        BorderBrush="{StaticResource Line}" BorderThickness="2"
                                                        CornerRadius="{StaticResource RadiusControl}" Padding="14,10">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19"
                                                                Background="{StaticResource GoldSoft}" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource MoneyModal}" FontSize="17"
                                                                       Foreground="{StaticResource Gold}" Text="{Binding Initial}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <TextBlock x:Name="Balance" DockPanel.Dock="Right" Style="{StaticResource MoneyModal}"
                                                                   FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Ink}"
                                                                   Text="{Binding BalanceDisplay}" VerticalAlignment="Center" />
                                                        <StackPanel Margin="12,0" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource BodyText}" FontWeight="Bold" Text="{Binding Name}" />
                                                            <TextBlock Style="{StaticResource BodyText}" FontSize="12"
                                                                       Foreground="{StaticResource Ink3}" Text="{Binding PhoneDisplay}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource Gold}" />
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource GoldSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="RowBg" Property="BorderBrush" Value="{StaticResource Gold}" />
                                                        <Setter TargetName="RowBg" Property="Background" Value="{StaticResource GoldSoft}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsZeroBalance}" Value="True">
                                                        <Setter TargetName="Balance" Property="Foreground" Value="{StaticResource Confirm}" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Visibility="{Binding AddingSuki, Converter={StaticResource InverseBoolToVis}}">
                            <Rectangle Stroke="{StaticResource LineStrong}" StrokeThickness="2" StrokeDashArray="3 3"
                                       RadiusX="10" RadiusY="10" SnapsToDevicePixels="True" />
                            <Button Style="{StaticResource BtnGhost}" BorderThickness="0" Background="Transparent"
                                    Foreground="{StaticResource Gold}" FontWeight="Bold" Content="＋ Add new suki"
                                    MinHeight="46" Command="{Binding ToggleAddSukiCommand}" />
                        </Grid>
                        <Grid Visibility="{Binding AddingSuki, Converter={StaticResource BoolToVis}}">
                            <Rectangle Stroke="{StaticResource Gold}" StrokeThickness="2" StrokeDashArray="3 3"
                                       RadiusX="10" RadiusY="10" SnapsToDevicePixels="True"
                                       Fill="{StaticResource Surface2}" />
                            <StackPanel Margin="12">
                                <Grid Margin="0,0,0,8">
                                    <TextBox x:Name="NewNameBox" Style="{StaticResource InputText}" MinHeight="40"
                                             Background="{StaticResource Surface}"
                                             Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="{StaticResource Ink3}" Text="Full name" Margin="12,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewName}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBox Style="{StaticResource InputText}" MinHeight="40"
                                             Background="{StaticResource Surface}"
                                             Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Foreground="{StaticResource Ink3}" Text="Phone (09xx…)" Margin="12,0"
                                               VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NewPhone}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource BtnConfirmSolid}" Content="Save &amp; select" MinHeight="40"
                                            Command="{Binding SaveSukiCommand}" />
                                    <Button Grid.Column="2" Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="40"
                                            Padding="14,0" Command="{Binding ToggleAddSukiCommand}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Caption}" Text="DOWN PAYMENT (OPTIONAL)" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource MoneyModal}" FontSize="30" Text="₱" Margin="0,0,4,0"
                                           VerticalAlignment="Center" />
                                <TextBox BorderThickness="0" Background="Transparent" TextAlignment="Left"
                                         FontFamily="{StaticResource FontDisplay}" FontSize="30" FontWeight="Bold"
                                         Foreground="{StaticResource Ink}" VerticalAlignment="Center" MinWidth="90" MaxLength="7"
                                         Text="{Binding Down.Digits, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="OnDownTextInput" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                                       Text="Cash received now — goes into the drawer as a collection."
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <comp:NumpadView Grid.Column="2" />
                    </Grid>
                </Border>
            </StackPanel>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="52" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnConfirmSolid}" Content="COMPLETE SALE" MinHeight="52"
                        Command="{Binding CompleteCommand}"
                        Visibility="{Binding IsInvoice, Converter={StaticResource InverseBoolToVis}}" />
                <Button Grid.Column="2" Style="{StaticResource BtnUtangSolid}" MinHeight="52" FontSize="13"
                        Content="{Binding CommitLabel}" Command="{Binding CompleteCommand}"
                        Visibility="{Binding IsInvoice, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
