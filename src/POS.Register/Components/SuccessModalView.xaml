<UserControl x:Class="POS.Register.Components.SuccessModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource ModalCard}" Width="440" Padding="40">
        <StackPanel HorizontalAlignment="Center">
            <Border Width="60" Height="60" CornerRadius="30" Background="{StaticResource ConfirmSoft}"
                    HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="✓" FontSize="28" Foreground="{StaticResource Confirm}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold" Text="Sale completed"
                       HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                       Text="{Binding ReceiptCaption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Caption}" Text="CHANGE" HorizontalAlignment="Center" Margin="0,14,0,0" />
            <TextBlock Style="{StaticResource MoneyLarge}" FontSize="58" Foreground="{StaticResource Confirm}"
                       Text="{Binding ChangeDisplay}" HorizontalAlignment="Center" />
            <Button Style="{StaticResource BtnPrimary}" Content="NEW SALE" MinHeight="56" Margin="0,16,0,0"
                    HorizontalAlignment="Stretch" Command="{Binding NewSaleCommand}" />
        </StackPanel>
    </Border>
</UserControl>
