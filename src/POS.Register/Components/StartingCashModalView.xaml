<UserControl x:Class="POS.Register.Components.StartingCashModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:POS.Register.Components">
    <Border Style="{StaticResource ModalCard}" Width="400" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold" Text="Declare starting cash" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink2}"
                       Text="Opens shift #12. Count the drawer before opening." Margin="0,0,0,14" />
            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="18,12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="STARTING CASH" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource MoneyModal}" FontSize="30" Text="₱" Margin="0,0,4,0" />
                        <TextBlock Style="{StaticResource MoneyModal}" FontSize="30" Text="{Binding AmountDisplay}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <comp:NumpadView Margin="0,0,0,14" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="52" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="OPEN SHIFT #12" MinHeight="52"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
