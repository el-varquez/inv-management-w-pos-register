<UserControl x:Class="POS.Register.Components.StartingCashModalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:POS.Register.Components">
    <Border Style="{StaticResource ModalCard}" Width="400" Padding="26">
        <StackPanel>
            <TextBlock Style="{StaticResource TitleSection}" FontSize="22" FontWeight="Bold" Text="Declare starting cash" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource BodyText}" FontSize="13" Foreground="{StaticResource Ink2}"
                       Text="{Binding Body}" Margin="0,0,0,14" />
            <Border BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusControl}" Padding="18,12" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="STARTING CASH" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource MoneyModal}" FontSize="30"
                               Text="₱" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBox BorderThickness="0" Background="Transparent" TextAlignment="Right"
                             FontFamily="{StaticResource FontDisplay}" FontSize="30" FontWeight="Bold"
                             Foreground="{StaticResource Ink}" VerticalAlignment="Center" MaxLength="7"
                             Text="{Binding Amount.Digits, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="OnAmountTextInput" />
                </DockPanel>
            </Border>
            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource Ink3}"
                       TextWrapping="Wrap" Margin="0,0,0,14"
                       Text="One figure for all register money — the drawer plus the e-wallet balance." />
            <comp:NumpadView Margin="0,0,0,14" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource BtnGhost}" Content="Cancel" MinHeight="52" Padding="20,0"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="{Binding ConfirmText}" MinHeight="52"
                        Command="{Binding ConfirmCommand}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
